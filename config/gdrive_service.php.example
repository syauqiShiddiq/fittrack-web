<?php
require_once __DIR__ . '/../vendor/autoload.php';

class GDriveService {
    private $service;
    
    // 1. Pastikan Folder ID benar
    private $folderId = 'MASUKAN_FOLDER_ID_GOOGLE_DRIVE_ANDA_DISINI'; 

    public function __construct() {
        $client = new Google\Client();
        
        // 2. Pastikan Client ID dan Secret benar tanpa spasi lebih
        $client->setClientId('MASUKAN_CLIENT_ID_GOOGLE_ANDA_DISINI');
        $client->setClientSecret('MASUKAN_CLIENT_SECRET_GOOGLE_ANDA_DISINI');
        
        $client->addScope(Google\Service\Drive::DRIVE_FILE);
        $client->setAccessType('offline');
        
        // 3. Tukar Refresh Token
        $token = $client->fetchAccessTokenWithRefreshToken('MASUKAN_REFRESH_TOKEN_GOOGLE_ANDA_DISINI');
        
        // 4. Debugging: Jika proses tukar token gagal, hentikan dan tampilkan alasannya
        if (isset($token['error'])) {
            die("TOKEN ERROR: " . $token['error_description'] . " (" . $token['error'] . ")");
        }
        
        // 5. INI KUNCI UTAMANYA: Pasang token secara eksplisit ke dalam sistem
        $client->setAccessToken($token);
        
        $this->service = new Google\Service\Drive($client);
    }

    public function uploadFile($filePath, $fileName, $mimeType) {
        $fileMetadata = new Google\Service\Drive\DriveFile([
            'name' => $fileName,
            'parents' => [$this->folderId]
        ]);

        try {
            $content = file_get_contents($filePath);
            $file = $this->service->files->create($fileMetadata, [
                'data' => $content,
                'mimeType' => $mimeType,
                'uploadType' => 'multipart',
                'fields' => 'id, webViewLink'
            ]);
            
            return [
                'id' => $file->id,
                'link' => $file->webViewLink
            ];
        } catch (Exception $e) {
            die("UPLOAD ERROR: " . $e->getMessage());
            return false;
        }
    }
}